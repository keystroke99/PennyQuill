{
  "name": "pennyquill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && concurrently -k -n api,web -c cyan,magenta \"wrangler dev --port 8787\" \"vite --host 0.0.0.0 --port 5173\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build:web": "vite build",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "db:migrate:local": "wrangler d1 migrations apply pennyquill-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pennyquill-db --remote",
    "cf:types": "wrangler types worker/cloudflare-env.d.ts",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
